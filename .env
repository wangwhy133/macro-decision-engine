# 宏观经济数据监控系统 - 环境变量配置
# ⚠️ 请将下方的占位符替换为真实的 API Key

# ==================== 数据源配置 ====================
# AkShare (中国数据，无需 Key，免费)
AKSHARE_ENABLED=true

# FRED (美国数据，需要 API Key)
# 获取地址：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=YOUR_FRED_API_KEY_HERE

# ==================== 通知推送配置 (可选) ====================
# Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 飞书通知
FEISHU_WEBHOOK=

# ==================== 系统配置 ====================
LOG_LEVEL=INFO
CACHE_TTL_HOURS=24
DATA_TIMEOUT_SECONDS=30
ANOMALY_DETECTION_ENABLED=true
ANOMALY_THRESHOLD=0.15

# ==================== AI 分析 (可选) ====================
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE
AI_MODEL=glm-4

# ==================== Dashboard 配置 ====================
DASHBOARD_PORT=8501
DASHBOARD_SERVER_ADDRESS=0.0.0.0
