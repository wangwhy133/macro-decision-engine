# 宏观经济数据监控系统 - 环境变量配置
# 复制此文件为 .env 并填入真实值

# ==================== 数据源配置 ====================
# AkShare (中国数据，无需 Key，免费)
AKSHARE_ENABLED=true

# FRED (美国数据，需要 API Key)
# 获取地址：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ==================== 通知推送配置 ====================
# Telegram 通知 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 飞书通知 (可选)
FEISHU_WEBHOOK=

# ==================== 系统配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 缓存 TTL (小时)
CACHE_TTL_HOURS=24

# 数据源超时时间 (秒)
DATA_TIMEOUT_SECONDS=30

# 是否启用异常检测
ANOMALY_DETECTION_ENABLED=true

# 异常阈值 (价格波动百分比)
ANOMALY_THRESHOLD=0.15

# ==================== AI 分析配置 (可选) ====================
# Zhipu AI (智谱 AI，用于智能分析)
# 获取地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 默认 AI 模型
AI_MODEL=glm-4

# ==================== Dashboard 配置 ====================
# Streamlit Dashboard 端口
DASHBOARD_PORT=8501

# 是否允许远程访问
DASHBOARD_SERVER_ADDRESS=0.0.0.0
