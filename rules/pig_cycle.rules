# 猪周期核心规则集
# 版本：v1.0.0
# 最后更新：2026-05-14

RULE pig_supply_shortage: "能繁母猪存栏大幅下降"
DESCRIPTION "当能繁母猪存栏量连续 3 个月下降且累计降幅超过 10%，预示未来 6-12 个月生猪供给收缩"
TYPE trend
CATEGORY pig_cycle
PRIORITY 9

CONDITION
  pig_inventory.change[T] < 0 AND
  pig_inventory.change[T-1] < 0 AND
  pig_inventory.change[T-2] < 0 AND
  SUM(pig_inventory.change, 3) < -0.10

THEN
  CONCLUSION "生猪供给将在未来 6-12 个月收缩，猪价上涨概率>70%"
  CONFIDENCE 0.75
  IMPACT positive
  HORIZON medium

METADATA
  SOURCE expert
  VALIDATED true
  SUCCESS_RATE 0.72
  VALIDATION_COUNT 15
END

RULE pig_grain_ratio_low: "猪粮比价跌破盈亏平衡点"
DESCRIPTION "当猪粮比价低于 5.5 且持续下降，养殖户亏损加剧，产能加速出清"
TYPE threshold
CATEGORY pig_cycle
PRIORITY 8

CONDITION
  pig_grain_ratio.value < 5.5 AND
  pig_grain_ratio.change < 0

THEN
  CONCLUSION "养殖户亏损加剧，产能加速出清，周期底部特征明显"
  CONFIDENCE 0.70
  IMPACT neutral
  HORIZON medium

METADATA
  SOURCE expert
  VALIDATED true
  SUCCESS_RATE 0.68
  VALIDATION_COUNT 22
END

RULE pig_inventory_low: "能繁母猪存栏处于历史低位"
DESCRIPTION "当能繁母猪存栏量低于过去 3 年平均值的 85%，处于周期底部区域"
TYPE pattern
CATEGORY pig_cycle
PRIORITY 7

CONDITION
  pig_inventory.value < AVG(pig_inventory.value, 12) * 0.85

THEN
  CONCLUSION "能繁母猪存栏处于历史低位，周期底部确认，未来 12 个月猪价上涨概率高"
  CONFIDENCE 0.65
  IMPACT positive
  HORIZON long

METADATA
  SOURCE mined
  VALIDATED true
  SUCCESS_RATE 0.61
  VALIDATION_COUNT 8
END

RULE pig_demand_seasonal: "猪肉消费旺季来临"
DESCRIPTION "当进入 Q4 且猪粮比价回升，需求拉动猪价上涨"
TYPE pattern
CATEGORY pig_cycle
PRIORITY 6

CONDITION
  IS_SEASONAL_PERIOD(MONTH(), 10, 11, 12) AND
  pig_grain_ratio.change > 0

THEN
  CONCLUSION "进入消费旺季后，猪价有望季节性上涨"
  CONFIDENCE 0.58
  IMPACT positive
  HORIZON short

METADATA
  SOURCE expert
  VALIDATED true
  SUCCESS_RATE 0.55
  VALIDATION_COUNT 12
END

RULE pig_disease_outbreak: "猪瘟等疫情爆发"
DESCRIPTION "当监测到疫情爆发且存栏量下降，供给冲击将推高猪价"
TYPE composite
CATEGORY pig_cycle
PRIORITY 10

CONDITION
  pig_disease.outbreak = true AND
  pig_inventory.change < -0.05

THEN
  CONCLUSION "疫情爆发叠加存栏下降，猪价可能快速上涨"
  CONFIDENCE 0.80
  IMPACT positive
  HORIZON short

METADATA
  SOURCE expert
  VALIDATED true
  SUCCESS_RATE 0.78
  VALIDATION_COUNT 6
END
