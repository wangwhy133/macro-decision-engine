# MDE 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ============ API 配置 ============
# MiniMax API Key (必需)
# 获取方式：https://api.minimax.chat/
MINIMAX_API_KEY=your_minimax_api_key_here

# MiniMax 模型 (可选，默认 MiniMax-M2.7)
MINIMAX_MODEL=MiniMax-M2.7

# ============ 数据源配置 ============
# 数据源优先级 (可选，默认：yfinance,akshare,simulation)
# DATA_SOURCES=yfinance,akshare,simulation

# ============ 风控配置 ============
# 安全模式：模拟数据禁止交易 (可选，默认：false)
MDE_SAFE_MODE=false

# 风控启用 (可选，默认：true)
MDE_RISK_CONTROL_ENABLED=true

# 记录安全事件 (可选，默认：true)
MDE_LOG_SECURITY_EVENTS=true

# ============ 日志配置 ============
# 日志级别 (可选，默认：INFO)
# LOG_LEVEL=INFO

# ============ 其他配置 ============
# 交易标的 (可选，默认：SPY)
# SYMBOL=SPY

# 手续费率 (可选，默认：0.001)
# COMMISSION_RATE=0.001
