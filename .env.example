# 宏观决策引擎环境变量配置
# 复制此文件为 .env 并填入真实值

# Tushare API Token (获取真实猪周期数据)
# 注册地址：https://tushare.pro
TUSHARE_TOKEN=your_tushare_token_here

# 数据源选择 (tushare | mock)
DATA_SOURCE=mock

# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info

# 是否启用 AI 解读 (需要配置 LLM API)
ENABLE_AI_INTERPRET=false

# AI 模型配置 (可选)
LLM_API_KEY=
LLM_MODEL=
