[Unit]
Description=Macro Decision Engine Daily Review
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.openclaw/workspace/macro-decision-engine
ExecStart=/usr/bin/npx tsx src/cli/daily-review.ts
Environment="NODE_ENV=production"
Environment="MDE_DB_PATH=/root/.openclaw/workspace/macro-decision.db"
Environment="MDE_DATA_SOURCE=simulator"
Environment="TUSHARE_TOKEN=your_token_here"
Environment="MDE_AI_API_KEY=your_key_here"

# 日志输出
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
